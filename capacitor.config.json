{
  "appId": "net.taibah.wireless",
  "appName": "كروت طيبة نت",
  "webDir": "dist",
  "server": {
    "androidScheme": "https",
    "cleartext": false
  },
  "plugins": {
    "StatusBar": {
      "overlaysWebView": false,
      "style": "DARK",
      "backgroundColor": "#0F172A"
    },
    "SplashScreen": {
      "launchShowDuration": 250,
      "launchAutoHide": true,
      "backgroundColor": "#0F172A",
      "androidScaleType": "CENTER_INSIDE",
      "showSpinner": false
    },
    "PushNotifications": {
      "presentationOptions": ["badge", "sound", "alert"]
    },
    "Keyboard": {
      "resize": "native",
      "resizeOnFullScreen": false
    },
    "CapacitorUpdater": {
      "autoUpdate": false
    }
  },
  "android": {
    "allowMixedContent": false,
    "captureInput": false,
    "webContentsDebuggingEnabled": false
  }
}
